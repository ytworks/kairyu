# Export these values in your shell; run.sh disables implicit Compose .env loading.
NVME_STORAGE_ROOT=/mnt/nvme/kairyu
API_BIND_ADDRESS=0.0.0.0
API_PORT=8003
DEEPSEEK_L1_PORT=8005
CHAT_UI_BIND_ADDRESS=0.0.0.0
CHAT_UI_PORT=3000
WEBUI_URL=http://localhost:3000
# Set once and preserve across gateway restarts. Never commit the actual value.
KAIRYU_RESPONSES_COMPACTION_SECRET=
# Optional full weight rehash; default checks manifest, all sizes and configuration bytes.
VERIFY_MODEL=0
