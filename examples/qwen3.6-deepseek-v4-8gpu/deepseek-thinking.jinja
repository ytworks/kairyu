{# DeepSeek V4 text-chat encoding with max thinking as this L2 tier's default. #}
{# The public direct model retains the sibling example's ordinary chat default. #}
{%- set mode = thinking_mode | default('thinking') -%}
{%- set effort = reasoning_effort | default('max') -%}
{%- if mode not in ['chat', 'thinking'] -%}
  {{- raise_exception('thinking_mode must be chat or thinking') -}}
{%- endif -%}
{%- if effort not in ['low', 'high', 'max'] -%}
  {{- raise_exception('reasoning_effort must be low, high, or max') -}}
{%- endif -%}
{{- '<｜begin▁of▁sentence｜>' -}}
{%- if mode == 'thinking' and effort == 'high' -%}
{{- 'Reason privately and carefully before answering. Check the important facts, constraints, and likely failure modes, then converge on a clear final response. Keep the private scratchpad proportional to the difficulty: be concise for straightforward requests and use deeper verification only when the task requires it. Preserve enough token budget to finish the answer. The completion is invalid unless a non-empty final answer immediately follows </think>; never stop at the marker.\n\n' -}}
{%- elif mode == 'thinking' and effort == 'max' -%}
{{- 'Use rigorous private reasoning to maximize answer quality. Independently verify consequential claims, preserve every explicit requirement, and test the chosen solution against relevant edge cases. Allocate effort in proportion to the task rather than narrating every possible path, converge promptly once the answer is supported, and always preserve enough token budget to emit the complete final response. The completion is invalid unless a non-empty final answer immediately follows </think>; never stop at the marker.\n\n' -}}
{%- endif -%}
{%- for message in messages -%}
  {%- set role = message['role'] -%}
  {%- if role == 'system' -%}
    {{- message['content'] or '' -}}
  {%- elif role == 'developer' -%}
    {{- '<｜User｜>' + (message['content'] or '') -}}
  {%- elif role == 'user' -%}
    {{- '<｜User｜>' + (message['content'] or '') -}}
  {%- elif role == 'assistant' -%}
    {{- (message['content'] or '') + '<｜end▁of▁sentence｜>' -}}
  {%- else -%}
    {{- raise_exception('unsupported role: ' + role) -}}
  {%- endif -%}
  {%- if role in ['user', 'developer'] and (loop.last or messages[loop.index0 + 1]['role'] in ['assistant', 'latest_reminder']) -%}
    {{- '<｜Assistant｜>' -}}
    {{- '<think>' if mode == 'thinking' else '</think>' -}}
  {%- endif -%}
{%- endfor -%}
